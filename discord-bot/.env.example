# Leave this blank to use the token saved in Undertow (Users > Discord bot), which is the safer way.
# Only fill it in to run the bot without Undertow holding the token.
DISCORD_TOKEN=

# Your Undertow server and an API key made in Users > API keys with "Allow audio streaming" and, to fetch the token, "Discord bot" turned on.
UNDERTOW_URL=https://undertow.example.com
UNDERTOW_KEY=

# Optional. A server (guild) id makes new slash commands appear instantly there; leave blank to register them everywhere (can take up to an hour to show).
GUILD_ID=

# Optional. CD (16-bit FLAC, the default), HI_RES, HIGH or LOW. Discord sends 48 kHz audio at most, so CD is plenty.
QUALITY=CD

# Optional. Minutes to stay in a voice channel with nothing playing before leaving.
IDLE_MINUTES=3

# Optional. What starts a text command, like g+play. Slash commands work either way.
PREFIX=g+

# Optional. The "Playing ..." line under the bot's name. Blank for none.
PRESENCE=hifi-api via Undertow

# Optional. The platform icon Discord shows next to the bot: vr (default), mobile, desktop, or off. Cosmetic and unofficial.
PLATFORM=vr

# Optional. Sites a page link may be on (yt-dlp reads them). Direct links to audio files and streams always work. * allows any site.
# URL_SITES=youtube.com,youtu.be,music.youtube.com,soundcloud.com,bandcamp.com,mixcloud.com,vimeo.com,twitch.tv,audiomack.com
